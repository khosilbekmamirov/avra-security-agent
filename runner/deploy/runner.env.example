AVRA_RUNNER_SCOPE_FILE=/etc/avra-runner/scope.yaml
AVRA_RUNNER_TOKEN_FILE=/etc/avra-runner/token
AVRA_RUNNER_AUDIT_LOG=/var/lib/avra-runner/audit/runner-audit.jsonl
AVRA_RUNNER_BIND_HOST=127.0.0.1
AVRA_RUNNER_PORT=8765
AVRA_RUNNER_EXEC_NMAP=/usr/lib/nmap/nmap
AVRA_RUNNER_EXEC_HTTP_PROBE=/opt/avra-runner/venv/bin/avra-http-probe
