# Copy to .env and fill in. Never commit the real .env (already in .gitignore).
# Only the settings below are read from .env; the process environment, if
# set, takes precedence over the file.

# Dedicated Anthropic API key for AVRA itself — separate from any key used
# by Claude Code. Set a monthly spend limit on it in the Anthropic Console.
# See docs/decisions/0001-initial-architecture-decisions.md item 10 (cost
# policy). Read by `avra research`.
ANTHROPIC_API_KEY=

# Bearer token for the Tool Runner on Kali (same value as the Runner's token
# file). Read by `avra scan nmap-connect` and `avra research` (ADR 0004).
AVRA_RUNNER_TOKEN=

# Not configured here (command-line flags instead):
#   session budget  -> `avra research --budget-usd` (default 0.50, max 5.00)
#   scope file      -> `--scope <path>`
# Runner-side (Kali) settings live in runner/deploy/runner.env.example.
